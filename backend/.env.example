# Base de datos (te la da Supabase o Neon al crear el proyecto)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Anthropic (para interpretar los mensajes)
ANTHROPIC_API_KEY=

# Dashboard
ADMIN_PASSWORD=elegi-una-contrasena-para-vos
JWT_SECRET=elegi-otra-frase-secreta-larga-y-random

# Puerto del servidor (Render/Railway lo pisan automáticamente)
PORT=3000
